# This file is served publicly by GitHub Pages, so it stays generic: it says
# which shapes of file never belong in the deploy, not what any of them are.
# Working documents themselves live outside this folder entirely — the ignore
# rules below are only a second line of defence, not the primary one.

# macOS
.DS_Store

# Local-only image masters
photo/_original/

# Document formats — nothing in these formats is ever part of the site
*.pdf
*.xls
*.xlsx
*.doc
*.docx
*.DOCX
*.ppt
*.pptx
*.csv

# Editor / working scratch
*.bak
*.bak[0-9]
*.orig
*.tmp
tmp_*
fix*
*.skill
_*.txt
_*.svg

# Local tooling config
.claude/

# Local assets that are not part of the deployed site
logo.png
ZZ_website_QRcode.png
newsletter-template.html
QR CODE/
social/
gemini-code-*.html

# scripts/ is deliberately NOT ignored. gen-pages.js is the source for the 76
# generated pages under knowledge/ column/ markets/ and for sitemap.xml, so
# ignoring it means a fresh clone regenerates them without the analytics and
# privacy blocks. deploy.sh also git-adds this directory and would abort under
# set -e if the path were ignored.
